{
  "name": "studio/laravel-totem",
  "description": "A Laravel package to manage your cron jobs through a beautiful dashboard",
  "keywords": [
    "laravel",
    "schedule",
    "manager",
    "totem",
    "cron"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Quentin Schmick",
      "email": "qschmick@gmail.com"
    },
    {
      "name": "Roshan Gautam",
      "email": "roshan.gautam@hotmail.com"
    }
  ],
  "require": {
    "php": "^8.2.0",
    "ext-json": "*",
    "illuminate/bus": "^10.0|^11.0|^12.0",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/contracts": "^10.0|^11.0|^12.0",
    "illuminate/database": "^10.0|^11.0|^12.0",
    "illuminate/events": "^10.0|^11.0|^12.0",
    "illuminate/notifications": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "laravel/vonage-notification-channel": "^3.3",
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0|^12.0"
  },
  "suggest": {
    "laravel/vonage-notification-channel": "Required for SMS notifications via Vonage."
  },
  "autoload": {
    "psr-4": {
      "Studio\\Totem\\": "src/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Studio\\Totem\\Tests\\": "tests/"
    }
  },
  "extra": {
    "component": "package",
    "laravel": {
      "providers": [
        "Studio\\Totem\\Providers\\TotemServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "dev"
}
